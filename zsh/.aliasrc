alias todo="$EDITOR ~/.todo"

alias tml="tmux list-sessions"
alias tma="tmux -2 attach -t $1"
tmk() { for s in "$@"; do tx stop "$s" 2>/dev/null || tmux kill-session -t "$s"; done; }
alias tx="tmuxinator"
alias txx='tmux new -A -s "${PWD:t}"'

alias g="git"
alias gs="git status"
alias gma="git commit -am"
alias gc="git checkout"
alias gcb="git checkout -b"
alias gl="git log --oneline"
alias gfa="git commit --amend --no-edit"
alias gca="git commit --amend"
alias gpom="git pull --rebase origin master 2> /dev/null || git pull --rebase origin main"
alias gp="git commit -p"
alias gbr="git branch"
alias gdr="git branch | grep -v "main" | xargs git branch -D"
alias merge-open-prs="gh pr list --json number -q '.[].number' | xargs -n1 gh pr merge --squash --delete-branch"

alias -g G="| grep --color"

alias b="bundle"
alias bx="bundle exec"
alias bup="bundle update"

alias mkdir="mkdir -p"
alias ls="eza --group-directories-first --long"
alias ll="ls"
alias rm="trash"
alias claer="clear"

alias cr=crystal

alias dc="docker compose"

alias tf=terraform

alias shrug="echo '¯\_(ツ)_/¯' | pbcopy"

alias rce="rails credentials:edit"
alias vim="nvim"
